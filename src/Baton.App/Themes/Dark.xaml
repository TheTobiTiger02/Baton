<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Theme.Name">Dark</sys:String>
    <!-- Fluent 2 (WinUI) palette. Translucent fills are meant to sit on the Mica backdrop; the
         Solid* colours are used where Mica is unavailable and for popups, which Mica never reaches.
         Accent* colours are replaced at runtime by the Windows accent (see ThemeManager). -->

    <Color x:Key="SolidBackgroundColor">#FF202020</Color>
    <Color x:Key="WindowColor">#FF202020</Color>
    <Color x:Key="NavigationColor">#FF2C2C2C</Color>
    <Color x:Key="LayerColor">#4C3A3A3A</Color>
    <Color x:Key="LayerStrokeColor">#19000000</Color>
    <Color x:Key="CardFillColor">#0DFFFFFF</Color>
    <Color x:Key="CardFillSecondaryColor">#08FFFFFF</Color>
    <Color x:Key="CardStrokeColor">#19000000</Color>
    <Color x:Key="SurfaceColor">#FF2C2C2C</Color>
    <Color x:Key="FlyoutColor">#FF2C2C2C</Color>
    <Color x:Key="FlyoutStrokeColor">#33000000</Color>
    <Color x:Key="SurfaceElevatedColor">#FF333333</Color>
    <Color x:Key="ControlFillColor">#0FFFFFFF</Color>
    <Color x:Key="ControlFillHoverColor">#15FFFFFF</Color>
    <Color x:Key="ControlFillPressedColor">#08FFFFFF</Color>
    <Color x:Key="ControlFillInputColor">#B31E1E1E</Color>
    <Color x:Key="SurfaceHoverColor">#0FFFFFFF</Color>
    <Color x:Key="SurfacePressedColor">#0AFFFFFF</Color>
    <Color x:Key="StrokeColor">#12FFFFFF</Color>
    <Color x:Key="ControlStrokeColor">#18FFFFFF</Color>
    <Color x:Key="ControlStrokeBottomColor">#10FFFFFF</Color>
    <Color x:Key="StrokeStrongColor">#8BFFFFFF</Color>
    <Color x:Key="DividerColor">#15FFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#FFCFCFCF</Color>
    <Color x:Key="TextTertiaryColor">#FF9D9D9D</Color>
    <Color x:Key="TextDisabledColor">#5DFFFFFF</Color>
    <Color x:Key="AccentColor">#FF60CDFF</Color>
    <Color x:Key="AccentHoverColor">#E660CDFF</Color>
    <Color x:Key="AccentPressedColor">#CC60CDFF</Color>
    <Color x:Key="AccentTextColor">#FF000000</Color>
    <Color x:Key="AccentSubtleColor">#2E60CDFF</Color>
    <Color x:Key="SuccessColor">#FF6CCB5F</Color>
    <Color x:Key="SuccessFillColor">#FF393D1B</Color>
    <Color x:Key="WarningColor">#FFFCE100</Color>
    <Color x:Key="CautionColor">#FFFCB900</Color>
    <Color x:Key="DangerColor">#FFFF99A4</Color>
    <Color x:Key="DangerFillColor">#FF442726</Color>
    <Color x:Key="InfoFillColor">#08FFFFFF</Color>
    <Color x:Key="SmokeColor">#4D000000</Color>
    <Color x:Key="CaptionCloseHoverColor">#FFC42B1C</Color>
    <Color x:Key="MediaColor">#FF000000</Color>

    <SolidColorBrush x:Key="SolidBackgroundBrush" Color="{StaticResource SolidBackgroundColor}" />
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="NavigationBrush" Color="{StaticResource NavigationColor}" />
    <SolidColorBrush x:Key="LayerBrush" Color="{StaticResource LayerColor}" />
    <SolidColorBrush x:Key="LayerStrokeBrush" Color="{StaticResource LayerStrokeColor}" />
    <SolidColorBrush x:Key="CardFillBrush" Color="{StaticResource CardFillColor}" />
    <SolidColorBrush x:Key="CardFillSecondaryBrush" Color="{StaticResource CardFillSecondaryColor}" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="FlyoutBrush" Color="{StaticResource FlyoutColor}" />
    <SolidColorBrush x:Key="FlyoutStrokeBrush" Color="{StaticResource FlyoutStrokeColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="{StaticResource ControlFillColor}" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="{StaticResource ControlFillHoverColor}" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="{StaticResource ControlFillPressedColor}" />
    <SolidColorBrush x:Key="ControlFillInputBrush" Color="{StaticResource ControlFillInputColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="{StaticResource ControlStrokeColor}" />
    <SolidColorBrush x:Key="ControlStrokeBottomBrush" Color="{StaticResource ControlStrokeBottomColor}" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="{StaticResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessFillBrush" Color="{StaticResource SuccessFillColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="CautionBrush" Color="{StaticResource CautionColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerFillBrush" Color="{StaticResource DangerFillColor}" />
    <SolidColorBrush x:Key="InfoFillBrush" Color="{StaticResource InfoFillColor}" />
    <SolidColorBrush x:Key="SmokeBrush" Color="{StaticResource SmokeColor}" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="{StaticResource CaptionCloseHoverColor}" />
    <SolidColorBrush x:Key="MediaBrush" Color="{StaticResource MediaColor}" />

    <!-- Buttons and inputs read as slightly raised: the bottom edge of the stroke differs. -->
    <LinearGradientBrush x:Key="ControlElevationBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource ControlStrokeColor}" />
        <GradientStop Offset="0.92" Color="{StaticResource ControlStrokeColor}" />
        <GradientStop Offset="1" Color="{StaticResource ControlStrokeBottomColor}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentElevationBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#14FFFFFF" />
        <GradientStop Offset="0.92" Color="#14FFFFFF" />
        <GradientStop Offset="1" Color="#33000000" />
    </LinearGradientBrush>
</ResourceDictionary>
