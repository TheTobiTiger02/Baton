<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:Baton.App"
                    xmlns:controls="clr-namespace:Baton.App.Controls">
    <!-- Baton's own building blocks on top of the ported Fluent styles. -->

    <app:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF2563EB" />
        <GradientStop Offset="1" Color="#FF7C3AED" />
    </LinearGradientBrush>

    <Style x:Key="ProgressTrack" TargetType="Border">
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
    </Style>

    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Padding" Value="12,5,14,6" />
    </Style>

    <!-- Artwork, or the activity's glyph on the brand gradient when there is none. -->
    <DataTemplate x:Key="ActivityArt" DataType="{x:Type app:ActivityViewModel}">
        <Grid Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}">
            <Border CornerRadius="6" Background="{StaticResource BrandGradient}">
                <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource IconGlyph}" FontSize="22" Foreground="White" />
            </Border>
            <Image Source="{Binding Artwork}" Stretch="UniformToFill" controls:Fluent.ClipRadius="6"
                   Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisConverter}}" />
        </Grid>
    </DataTemplate>

    <!-- The card every activity is shown as: art, title, where it runs, progress, and what can be done with it. -->
    <DataTemplate x:Key="ActivityCard" DataType="{x:Type app:ActivityViewModel}">
        <Border Style="{StaticResource PageCard}" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActivityArt}" Tag="64" VerticalAlignment="Top" Focusable="False" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisConverter}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisConverter}}" />
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                    <Grid Margin="0,8,0,0" Visibility="{Binding HasPlayback, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ProgressTrack}" VerticalAlignment="Center">
                            <Border CornerRadius="2" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Progress}" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource CaptionText}" Margin="10,0,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Grid>
                </StackPanel>
                <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Actions}" Margin="0,12,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type app:ActivityAction}">
                            <Button Command="{Binding Command}" Style="{StaticResource ActionButton}" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Label}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- A device heading: icon, name, connection state. -->
    <DataTemplate x:Key="DeviceHeader" DataType="{x:Type app:DeviceViewModel}">
        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
            <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSubtleBrush}">
                <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
