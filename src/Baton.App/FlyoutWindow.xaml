<Window x:Class="Baton.App.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Baton.App"
        xmlns:controls="clr-namespace:Baton.App.Controls"
        Title="Baton" Width="400" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Style="{StaticResource {x:Type Window}}"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <DataTemplate x:Key="CompactActivity" DataType="{x:Type app:ActivityViewModel}">
            <Border Background="{DynamicResource CardFillBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActivityArt}" Tag="44" Focusable="False" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusLine}" Style="{StaticResource CaptionText}" />
                        <Border Style="{StaticResource ProgressTrack}" Height="3" Margin="0,6,0,0"
                                Visibility="{Binding HasPlayback, Converter={StaticResource BoolToVisConverter}}">
                            <Border CornerRadius="1.5" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Progress}" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Buttons}" ItemTemplate="{StaticResource ActionItem}"
                                  Margin="0,8,0,0" Focusable="False" ButtonBase.Click="Action_Click">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="12" Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource FlyoutStrokeBrush}" BorderThickness="1"
            CornerRadius="8" Effect="{StaticResource FlyoutShadow}">
        <StackPanel Margin="16,12,16,16">
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Open Baton" Click="Open_Click" />
                <Image Source="Assets/Baton.png" Width="18" Height="18" />
                <TextBlock Text="Baton" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </DockPanel>

            <Border Style="{StaticResource InfoBar}" Margin="0,0,0,12" Background="{DynamicResource AccentSubtleBrush}"
                    Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisConverter}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Stop" Command="{Binding StopStreaming}" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE7F4;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"><Run Text="Streaming " /><Run Text="{Binding Streaming, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" to your phone" /></TextBlock>
                </DockPanel>
            </Border>
            <TextBlock Text="On this PC" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
            <ItemsControl x:Name="LocalList" ItemTemplate="{StaticResource CompactActivity}" Focusable="False" />
            <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Nothing playing or open right now."
                       Visibility="{Binding Local.HasActivity, Converter={StaticResource InverseBoolToVis}}" />

            <ItemsControl ItemsSource="{Binding Phones}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type app:DeviceViewModel}">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,6">
                                <Run Text="On " /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StatusText, Mode=OneWay}" />
                            </TextBlock>
                            <ContentControl Content="{Binding Top}" ContentTemplate="{StaticResource CompactActivity}" Focusable="False"
                                            Visibility="{Binding HasActivity, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0">
                <Run Text="{Binding SendHotkey, Mode=OneWay}" /><Run Text=" sends to your phone · " /><Run Text="{Binding ContinueHotkey, Mode=OneWay}" /><Run Text=" continues here" />
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
