<Window x:Class="Baton.App.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Baton.App.Controls"
        Title="Pair a phone" Icon="Assets/Baton.ico" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <controls:CaptionButtons HorizontalAlignment="Right" />
        <StackPanel Margin="32,48,32,28">
            <TextBlock Text="Pair a phone" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,20"
                       Text="Open Baton on your Android phone and scan this code. Your phone's camera app works too." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="White" CornerRadius="12" Padding="14" Width="232" Height="232">
                    <Image x:Name="QrImage" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Or enter this code" Style="{StaticResource CaptionText}" />
                    <TextBlock x:Name="CodeText" FontFamily="{StaticResource DisplayFontFamily}" FontSize="40" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="after choosing this PC in the Baton app. Both devices must be on the same Wi-Fi." />
                    <TextBlock x:Name="ExpiryText" Style="{StaticResource CaptionText}" Margin="0,16,0,0" Foreground="{DynamicResource TextTertiaryBrush}" />
                    <Button x:Name="RefreshButton" Content="New code" Margin="0,8,0,0" HorizontalAlignment="Left" Click="Refresh_Click" />
                </StackPanel>
            </Grid>

            <DockPanel Margin="0,24,0,0">
                <Border DockPanel.Dock="Left" Background="White" CornerRadius="8" Padding="8" Width="96" Height="96">
                    <Image x:Name="AppQr" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="No Baton on the phone yet?" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Text="Scan this with the phone's camera to download the app, install it, then scan the code above." />
                </StackPanel>
            </DockPanel>

            <Border x:Name="SuccessBar" Style="{StaticResource InfoBar}" Margin="0,24,0,0" Visibility="Collapsed" Background="{DynamicResource SuccessFillBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,10,0" />
                    <TextBlock x:Name="SuccessText" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
